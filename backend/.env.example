# ===================================================
# Hungry Howie's POS - Backend Environment Configuration
# ===================================================

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=*

# Database (PostgreSQL - Future Phase)
